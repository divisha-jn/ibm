# IBM watsonx.ai
# Leave these blank until you have access to your IBM project.
WATSONX_APIKEY=
WATSONX_PROJECT_ID=

# Region endpoint for your IBM project.
WATSONX_URL=https://jp-tok.ml.cloud.ibm.com

# Model in use.
WATSONX_MODEL_ID=ibm/llama-3-3-70b-instruct

# watsonx chat API version.
WATSONX_API_VERSION=2025-10-25

# Request timeout in seconds.
WATSONX_TIMEOUT_SECONDS=60
